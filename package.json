{
  "name": "sugargoo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "uni -p h5",
    "dev:h5": "uni -p h5",
    "dev:app": "uni -p app",
    "build:h5": "uni build -p h5",
    "build:app": "uni build -p app",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "dev:server": "node --watch server/index.js",
    "start:server": "node server/index.js",
    "test:server": "node --test server/*.test.js"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@eslint/js": "9.39.1",
    "@vue/runtime-core": "3.4.21",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "9.33.0",
    "globals": "15.15.0",
    "prettier": "3.6.2",
    "sass": "1.105.1",
    "vite": "5.2.8"
  }
}
